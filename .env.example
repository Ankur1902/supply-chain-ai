# =============================================================================
# AI Supply Chain Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development                 # development | test | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# --- Ports (host-side; non-default to avoid colliding with other local projects) ---
BACKEND_PORT=8001
FRONTEND_PORT=3001

# --- MySQL (primary datastore) ---
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=ai_supply_chain
MYSQL_USER=supply_chain_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql+pymysql://supply_chain_app:change-me@localhost:3307/ai_supply_chain

# --- MySQL read-only user, used ONLY by the AI text-to-SQL / analytics layer ---
# This user is granted SELECT-only on an explicit view/table allowlist.
# See docs/security.md and scripts/sql/create_readonly_user.sql
MYSQL_READONLY_USER=supply_chain_ai_ro
MYSQL_READONLY_PASSWORD=change-me-ro
READONLY_DATABASE_URL=mysql+pymysql://supply_chain_ai_ro:change-me-ro@localhost:3307/ai_supply_chain

# --- Redis (cache + background job queue) ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Provider ---
# LLM_PROVIDER selects which backend the AI abstraction layer talks to.
LLM_PROVIDER=anthropic               # anthropic | google | none (falls back to deterministic-only mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- AI safety limits ---
AI_MAX_TOKENS_PER_REQUEST=4096
AI_TOOL_CALL_TIMEOUT_SECONDS=15
AI_SQL_ROW_LIMIT=500
AI_SQL_TIMEOUT_SECONDS=5
AI_MAX_TOOL_CALLS_PER_TURN=6

# --- ML ---
MODEL_PATH=ml/artifacts
MODEL_REGISTRY_ACTIVE_VERSION=latest

# --- Vector DB (RAG) ---
VECTOR_DB_PATH=knowledge_base/chroma_db
VECTOR_DB_COLLECTION=supply_chain_kb

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3001

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=20

# --- Frontend (public, safe to expose in browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1
